  <CookieProcessor httpOnly="true" sameSiteCookies="strict" secure="true"/>
  <Manager className="org.apache.catalina.session.PersistentManager" saveOnRestart="false"/>
  <SessionCookieName>JSESSIONID</SessionCookieName>
</Context>
